# Proveedor por defecto: gemini | groq | openrouter | mistral | custom | anthropic
DOC_INSIGHT_PROVIDER=gemini

# Completá SOLO la key del proveedor que vayas a usar (todas tienen plan gratuito salvo Anthropic).
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
MISTRAL_API_KEY=       # https://console.mistral.ai/
# ANTHROPIC_API_KEY=   # opcional, de pago
# DOC_INSIGHT_API_KEY= # sólo para --provider custom
